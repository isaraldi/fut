<%
    const caminho = typeof caminhoAtual !== 'undefined' ? caminhoAtual : '';
    const ativo = (p) => caminho === p;
    const grupoAberto = (prefixos) => prefixos.some(p => caminho.startsWith(p));
%>
<aside class="sidebar">
    <div class="sidebar-brand">
        <% if (typeof logoUrlSidebar !== 'undefined' && logoUrlSidebar) { %>
            <img src="<%= logoUrlSidebar %>" alt="Logo">
        <% } else { %>
            <span style="font-size:1.4rem">⚽</span>
        <% } %>
        <span>Painel do Fut</span>
    </div>

    <nav class="sidebar-nav">
        <a class="nav-link <%= ativo('/') ? 'active' : '' %>" href="/">
            <span class="icon">🏠</span> Início
        </a>

        <details class="nav-group" <%= grupoAberto(['/confirmados', '/jogos', '/times', '/jogo/atual']) ? 'open' : '' %>>
            <summary><span class="icon">⚽</span> Jogos <span class="chevron">▸</span></summary>
            <div class="nav-sub">
                <a class="nav-link <%= ativo('/jogo/atual') ? 'active' : '' %>" href="/jogo/atual">Jogo atual</a>
                <a class="nav-link <%= caminho.startsWith('/jogos') ? 'active' : '' %>" href="/jogos">Histórico</a>
            </div>
        </details>

        <details class="nav-group" <%= grupoAberto(['/pagamentos', '/mensal', '/caixa']) ? 'open' : '' %>>
            <summary><span class="icon">💰</span> Financeiro <span class="chevron">▸</span></summary>
            <div class="nav-sub">
                <a class="nav-link <%= ativo('/caixa') ? 'active' : '' %>" href="/caixa">Caixa</a>
                <a class="nav-link <%= caminho.startsWith('/mensal') ? 'active' : '' %>" href="/mensal">Mensalistas</a>
                <a class="nav-link <%= caminho.startsWith('/pagamentos') ? 'active' : '' %>" href="/pagamentos">Pagamentos</a>
            </div>
        </details>

        <details class="nav-group" <%= (ativo('/elenco') || (caminho.startsWith('/elenco/') && !caminho.startsWith('/elenco/config'))) ? 'open' : '' %>>
            <summary><span class="icon">👥</span> Jogadoras <span class="chevron">▸</span></summary>
            <div class="nav-sub">
                <a class="nav-link <%= ativo('/elenco') ? 'active' : '' %>" href="/elenco">Ativas</a>
                <a class="nav-link <%= ativo('/elenco/inativos') ? 'active' : '' %>" href="/elenco/inativos">
                    Inativas<% if (jogadorasInativasCount > 0) { %> (<%= jogadorasInativasCount %>)<% } %>
                </a>
            </div>
        </details>

        <details class="nav-group" <%= grupoAberto(['/mensagens']) ? 'open' : '' %>>
            <summary><span class="icon">💬</span> Comunicação <span class="chevron">▸</span></summary>
            <div class="nav-sub">
                <a class="nav-link <%= ativo('/mensagens') ? 'active' : '' %>" href="/mensagens">Envios e agendamentos</a>
                <a class="nav-link <%= ativo('/mensagens/automaticas') ? 'active' : '' %>" href="/mensagens/automaticas">Modelos e automações</a>
            </div>
        </details>

        <details class="nav-group" <%= grupoAberto(['/elenco/config', '/jogo/config', '/enquete/config', '/logs', '/comandos', '/configuracoes', '/usuarios']) ? 'open' : '' %>>
            <summary><span class="icon">⚙️</span> Configurações <span class="chevron">▸</span></summary>
            <div class="nav-sub">
                <a class="nav-link <%= ativo('/elenco/config') ? 'active' : '' %>" href="/elenco/config">Cadastro e sincronização</a>
                <a class="nav-link <%= ativo('/jogo/config') ? 'active' : '' %>" href="/jogo/config">Regras do jogo</a>
                <a class="nav-link <%= ativo('/enquete/config') ? 'active' : '' %>" href="/enquete/config">Enquete e envio automático</a>
                <a class="nav-link <%= ativo('/comandos') ? 'active' : '' %>" href="/comandos">Comandos e permissões</a>
                <a class="nav-link <%= ativo('/logs') ? 'active' : '' %>" href="/logs">Atividade do bot</a>
                <a class="nav-link <%= ativo('/usuarios') ? 'active' : '' %>" href="/usuarios">Usuários</a>
                <a class="nav-link <%= ativo('/configuracoes/aparencia') ? 'active' : '' %>" href="/configuracoes/aparencia">Aparência</a>
            </div>
        </details>
    </nav>

    <div class="sidebar-footer">
        <div class="theme-toggle">
            <button type="button" data-theme-choice="light">Claro</button>
            <button type="button" data-theme-choice="auto">Auto</button>
            <button type="button" data-theme-choice="dark">Escuro</button>
        </div>
        <div class="user-row">
            <span><%= typeof usuario !== 'undefined' ? usuario : '' %></span>
            <form method="post" action="/logout" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="secondary" type="submit" style="padding:5px 10px;font-size:0.8rem">Sair</button>
            </form>
        </div>
    </div>
</aside>
