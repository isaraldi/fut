<div class="page-header">
    <div>
        <h1><%= jogador.nome %></h1>
        <p><a href="/mensal">&larr; Voltar para mensalistas</a></p>
    </div>
</div>

<div class="card">
    <h2>Participação atual: <span class="badge <%= jogador.papel %>"><%= jogador.papel %></span></h2>
</div>

<div class="card">
    <h1>Histórico de participação</h1>
    <% if (historico.length === 0) { %>
        <p class="empty">Nenhuma mudança de vínculo mensal registrada.</p>
    <% } else { %>
        <table>
            <thead>
                <tr><th>De</th><th>Para</th><th>Quando</th></tr>
            </thead>
            <tbody>
                <% historico.forEach(h => { %>
                    <tr>
                        <td><%= h.papel_anterior ? h.papel_anterior : '(criado)' %></td>
                        <td><span class="badge <%= h.papel_novo %>"><%= h.papel_novo %></span></td>
                        <td><%= formatarDataHora(h.alterado_em) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>
