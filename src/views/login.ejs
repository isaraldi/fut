<div class="login-wrap">
    <div class="card login-card">
        <% if (typeof logoUrl !== 'undefined' && logoUrl) { %>
            <img class="login-logo" src="<%= logoUrl %>" alt="Logo do time">
        <% } %>
        <h1>⚽ Painel do Fut</h1>
        <% if (erro) { %>
            <p class="erro"><%= erro %></p>
        <% } %>
        <form method="post" action="/login" autocomplete="on"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="usuario">Usuário</label>
            <input type="text" id="usuario" name="usuario" autocomplete="username" autofocus required>
            <label for="senha">Senha</label>
            <input type="password" id="senha" name="senha" autocomplete="current-password" required>
            <input type="submit" value="Entrar">
        </form>
    </div>
</div>
