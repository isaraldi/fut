<div class="config-save-bar" role="region" aria-label="Alterações da página" hidden>
    <div>
        <span role="status" data-config-status>Alterações não salvas</span>
        <p class="erro" role="alert" data-config-error hidden></p>
    </div>
    <div class="config-save-actions">
        <button type="button" class="secondary" data-config-discard>Descartar</button>
        <button type="button" data-config-save>Salvar alterações</button>
    </div>
</div>
