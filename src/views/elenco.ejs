<div class="page-header">
    <div>
        <h1>Jogadoras</h1>
        <p><%= jogadores.length %> cadastrada<%= jogadores.length === 1 ? '' : 's' %></p>
    </div>
    <button type="button" data-jogadora-adicionar>Adicionar jogadora</button>
</div>

<div class="card elenco-lista">
    <div class="elenco-toolbar">
        <div class="elenco-busca">
            <label for="elenco-busca">Buscar jogadora</label>
            <input id="elenco-busca" type="search" placeholder="Buscar por nome" autocomplete="off">
        </div>
        <div class="elenco-filtros" role="group" aria-label="Filtrar participação">
            <% [['todas', 'Todas'], ['mensalista', 'Mensalistas'], ['avulso', 'Avulsas']].forEach(([valor, rotulo]) => { %>
                <button type="button" class="secondary" data-elenco-filtro="<%= valor %>" aria-pressed="<%= valor === 'todas' %>"><%= rotulo %> <span><%= valor === 'todas' ? jogadores.length : jogadores.filter(j => j.papel === valor).length %></span></button>
            <% }) %>
        </div>
    </div>
    <p class="hint">Nome, contato e perfil para os times. O vínculo mensal é gerenciado em <a href="/mensal">Mensalistas</a>.</p>
    <p class="hint" role="status" data-elenco-resultado><%= jogadores.length %> jogadora(s)</p>
    <% if (!jogadores.length) { %>
        <p class="empty">Nenhuma jogadora cadastrada. Use “Adicionar jogadora” para começar.</p>
    <% } else { %>
        <table class="elenco-tabela">
            <thead><tr><th>Jogadora</th><th>Perfil para os times</th><th><span class="sr-only">Ações</span></th></tr></thead>
            <tbody>
                <% jogadores.forEach(j => { %>
                    <tr data-jogadora-row data-jogadora-id="<%= j.id %>" data-participacao="<%= j.papel %>">
                        <td><strong data-jogadora-nome><%= j.nome %></strong>
                            <% if (j.papel === 'mensalista') { %><a class="badge mensalista" href="/mensal">Mensalista</a><% } %>
                            <span class="elenco-alterada" data-jogadora-alterada hidden>Alterada</span></td>
                        <td>
                            <form data-config-form id="jogadora-<%= j.id %>" method="post" action="/elenco/<%= j.id %>/atualizar">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="text" hidden name="nome" value="<%= j.nome %>">
                                <input type="text" hidden name="telefone" value="<%= j.telefone || '' %>">
                                <input type="text" hidden name="nivel" value="<%= j.nivel %>">
                                <input type="text" hidden name="posicao" value="<%= j.posicao %>">
                                <span class="elenco-perfil" data-jogadora-perfil><%= j.posicao === 'indefinida' ? 'Posição não informada' : j.posicao %> · Nível <%= j.nivel %></span>
                                <button type="submit">Salvar</button>
                            </form>
                        </td>
                        <td class="elenco-acoes"><button type="button" class="secondary" data-jogadora-editar aria-label="Editar <%= j.nome %>">Editar</button></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        <p class="empty" data-elenco-vazio hidden>Nenhuma jogadora encontrada. Altere a busca ou o filtro.</p>
    <% } %>
</div>
<noscript><p class="hint">Ative JavaScript para usar a busca e editar os dados completos.</p></noscript>

<dialog id="jogadora-nova" class="jogadora-drawer" aria-labelledby="jogadora-nova-titulo">
    <div class="jogadora-drawer-header">
        <h2 id="jogadora-nova-titulo">Adicionar jogadora</h2>
        <button type="button" class="secondary" data-dialog-fechar aria-label="Fechar cadastro">Fechar</button>
    </div>
    <form method="post" action="/elenco">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('_jogadora-dados', { prefixo: 'nova' }) %>
        <p class="hint">Novas jogadoras entram como avulsas. Gerencie o vínculo mensal em <a href="/mensal">Mensalistas</a>.</p>
        <div class="jogadora-drawer-footer">
            <button type="button" class="secondary" data-dialog-fechar>Cancelar</button>
            <button type="submit">Adicionar jogadora</button>
        </div>
    </form>
</dialog>

<dialog id="jogadora-edicao" class="jogadora-drawer" aria-labelledby="jogadora-edicao-titulo">
    <div class="jogadora-drawer-header">
        <h2 id="jogadora-edicao-titulo">Editar jogadora</h2>
        <button type="button" class="secondary" data-dialog-fechar aria-label="Fechar edição">Fechar</button>
    </div>
    <form method="dialog" id="jogadora-editor">
        <%- include('_jogadora-dados', { prefixo: 'editar' }) %>
        <p class="hint">Ao concluir, confirme as mudanças em “Salvar alterações”.</p>
        <div class="jogadora-drawer-footer">
            <button type="button" class="secondary" data-dialog-fechar>Cancelar</button>
            <button type="submit">Concluir edição</button>
        </div>
    </form>
    <div class="jogadora-drawer-extra">
        <a href="/mensal">Gerenciar vínculo mensal</a>
        <form id="jogadora-remover" method="post" action="/elenco" data-confirm="Excluir {nome} e seu histórico de pagamentos e presenças? Esta ação não pode ser desfeita.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="danger">Remover jogadora</button>
        </form>
    </div>
</dialog>
<script src="/elenco.js" defer></script>
