<div class="page-header">
    <div>
        <h1>Envios e agendamentos</h1>
        <p>Envie agora ou agende mensagens. Textos das respostas do bot ficam em <a href="/mensagens/automaticas">Modelos e automações</a>.</p>
    </div>
</div>

<section class="section">
    <div class="card">
        <h1>Enviar mensagem privada</h1>
        <p class="hint">Envia no privado de cada jogadora do público escolhido. Use <code>{nome}</code> para personalizar. Os envios são espaçados e podem levar alguns minutos; acompanhe em <a href="/logs">Atividade do bot</a>. Para enviar depois, agende abaixo.</p>
        <form method="post" action="/mensagens/jogadoras" data-confirm="Enviar essa mensagem no privado pra cada jogadora do público escolhido?"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-row">
                <div>
                    <label for="mensagens-campo-1">Público</label>
                    <select id="mensagens-campo-1" name="publico">
                        <% publicosJogadoras.forEach(p => { %>
                            <option value="<%= p.chave %>"><%= p.titulo %> — <%= p.destinatarias.length %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div>
                <label for="mensagens-campo-2">Mensagem</label>
                <textarea id="mensagens-campo-2" name="texto" rows="5" required placeholder="Oi, {nome}! ..."><%= mensagemJogadorasTexto %></textarea>
            </div>
            <% publicosJogadoras.forEach(p => { %>
                <details style="margin:8px 0">
                    <summary><%= p.titulo %>: <%= p.destinatarias.length %> jogadora(s)</summary>
                    <p class="hint"><%= p.destinatarias.length ? p.destinatarias.map(j => j.nome + (j.whatsapp_id || j.telefone ? '' : ' (sem número)')).join(', ') : 'Ninguém por enquanto.' %></p>
                </details>
            <% }) %>
            <input type="submit" value="Enviar no privado">
        </form>
    </div>
</section>

<section class="section">
    <div class="card">
        <h1>Agendar mensagem</h1>
        <p class="hint">Envie uma vez ou toda semana, para um grupo ou no privado de um público. As destinatárias são definidas na hora do envio. O bot verifica os agendamentos a cada minuto.</p>
        <% if (grupos.length === 0) { %>
            <p class="hint">Nenhum grupo disponível. Aguarde o bot conectar ao WhatsApp e atualize a página. Você ainda pode selecionar um público.</p>
        <% } %>
        <form method="post" action="/mensagens" class="form-mensagem"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-row">
                <div>
                    <label for="mensagens-campo-3">Destino</label>
                    <select id="mensagens-campo-3" name="grupoId" required>
                        <option value="" selected disabled>Selecione um grupo ou público</option>
                        <optgroup label="Grupos">
                            <% grupos.forEach(g => { %>
                                <option value="<%= g.whatsapp_id %>"><%= g.nome %></option>
                            <% }) %>
                        </optgroup>
                        <optgroup label="Mensagem privada (uma por jogadora; aceita {nome})">
                            <% publicosJogadoras.forEach(p => { %>
                                <option value="jogadoras:<%= p.chave %>"><%= p.titulo %></option>
                            <% }) %>
                        </optgroup>
                    </select>
                </div>
            </div>
            <div>
                <label for="mensagens-campo-4">Mensagem</label>
                <textarea id="mensagens-campo-4" name="texto" rows="4" required></textarea>
            </div>

            <div class="switch-row">
                <label class="radio-label"><input type="radio" name="tipo" value="unica" checked> Uma vez</label>
            </div>
            <div class="switch-row">
                <label class="radio-label"><input type="radio" name="tipo" value="semanal"> Toda semana</label>
            </div>

            <div class="campo-data form-row">
                <div>
                    <label for="mensagens-campo-5">Data</label>
                    <input id="mensagens-campo-5" type="date" name="data" required>
                </div>
            </div>
            <div class="campo-dia-semana form-row" style="display:none">
                <div>
                    <label for="mensagens-campo-6">Dia da semana</label>
                    <select id="mensagens-campo-6" name="diaSemana">
                        <option value="0">Domingo</option>
                        <option value="1">Segunda-feira</option>
                        <option value="2">Terça-feira</option>
                        <option value="3">Quarta-feira</option>
                        <option value="4">Quinta-feira</option>
                        <option value="5">Sexta-feira</option>
                        <option value="6">Sábado</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div>
                    <span class="field-label">Horário</span>
                    <div class="time-select">
                        <select aria-label="Hora do envio" name="horaH">
                            <% for (let h = 0; h < 24; h++) { %>
                                <% const hh = String(h).padStart(2, '0'); %>
                                <option value="<%= hh %>" <%= hh === '09' ? 'selected' : '' %>><%= hh %></option>
                            <% } %>
                        </select>
                        <span>:</span>
                        <select aria-label="Minutos do envio" name="horaM">
                            <% ['00','15','30','45'].forEach(mm => { %>
                                <option value="<%= mm %>"><%= mm %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
            </div>
            <input type="submit" value="Agendar mensagem">
        </form>
    </div>

    <div class="card">
        <h1>Agendamentos (<%= mensagens.length %>)</h1>
        <% if (mensagens.length === 0) { %>
            <p class="empty">Nenhuma mensagem agendada ainda.</p>
        <% } else { %>
            <table>
                <thead>
                    <tr><th>Destino</th><th>Mensagem</th><th>Quando</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    <% const NOMES_DIA_SEMANA = ['domingo', 'segunda-feira', 'terça-feira', 'quarta-feira', 'quinta-feira', 'sexta-feira', 'sábado']; %>
                    <% mensagens.forEach(m => { %>
                        <tr>
                            <% const publicoDaLinha = publicosJogadoras.find(p => 'jogadoras:' + p.chave === m.grupo_id); %>
                            <td><%= m.grupo_nome || (publicoDaLinha ? '💌 ' + publicoDaLinha.titulo : m.grupo_id) %></td>
                            <td style="max-width:320px;white-space:pre-wrap"><%= m.texto %></td>
                            <td style="white-space:nowrap">
                                <% if (m.tipo === 'semanal') { %>
                                    Toda <%= NOMES_DIA_SEMANA[m.dia_semana] %> às <%= m.hora %>
                                <% } else { %>
                                    <%= m.enviar_em %>
                                <% } %>
                            </td>
                            <td>
                                <% if (m.tipo === 'semanal') { %>
                                    <span class="badge avulso">Recorrente</span>
                                    <% if (m.ultimo_envio) { %>
                                        <div class="hint" style="margin:2px 0 0">último envio: <%= m.ultimo_envio %></div>
                                    <% } %>
                                <% } else if (m.enviada_em) { %>
                                    <span class="badge enviada">Enviada</span>
                                <% } else { %>
                                    <span class="badge pendente">Pendente</span>
                                <% } %>
                            </td>
                            <td style="white-space:nowrap">
                                <button type="button" class="icon-btn secondary edit-toggle" data-target="editar-<%= m.id %>" title="Editar" aria-label="Editar agendamento">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                </button>
                                <form method="post" action="/mensagens/<%= m.id %>/excluir" style="display:inline" data-confirm="Remover esse agendamento?"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="icon-btn danger" type="submit" title="Excluir" aria-label="Excluir agendamento">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <tr class="edit-row" id="editar-<%= m.id %>" style="display:none">
                            <td colspan="5">
                                <form method="post" action="/mensagens/<%= m.id %>/editar" class="form-mensagem"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <p class="hint">Salvar reagenda o envio. Mensagens já enviadas voltam a ficar pendentes.</p>
                                    <div class="form-row">
                                        <div>
                                            <label for="mensagens-campo-7-<%= m.id %>">Destino</label>
                                            <select id="mensagens-campo-7-<%= m.id %>" name="grupoId" required>
                                                <optgroup label="Grupos">
                                                    <% grupos.forEach(g => { %>
                                                        <option value="<%= g.whatsapp_id %>" <%= g.whatsapp_id === m.grupo_id ? 'selected' : '' %>><%= g.nome %></option>
                                                    <% }) %>
                                                </optgroup>
                                                <optgroup label="Mensagem privada (uma por jogadora; aceita {nome})">
                                                    <% publicosJogadoras.forEach(p => { %>
                                                        <option value="jogadoras:<%= p.chave %>" <%= 'jogadoras:' + p.chave === m.grupo_id ? 'selected' : '' %>><%= p.titulo %></option>
                                                    <% }) %>
                                                </optgroup>
                                            </select>
                                        </div>
                                    </div>
                                    <div>
                                        <label for="mensagens-campo-8-<%= m.id %>">Mensagem</label>
                                        <textarea id="mensagens-campo-8-<%= m.id %>" name="texto" rows="4" required><%= m.texto %></textarea>
                                    </div>

                                    <div class="switch-row">
                                        <label class="radio-label"><input type="radio" name="tipo" value="unica" <%= m.tipo === 'unica' ? 'checked' : '' %>> Uma vez</label>
                                    </div>
                                    <div class="switch-row">
                                        <label class="radio-label"><input type="radio" name="tipo" value="semanal" <%= m.tipo === 'semanal' ? 'checked' : '' %>> Toda semana</label>
                                    </div>

                                    <div class="campo-data form-row" style="<%= m.tipo === 'semanal' ? 'display:none' : '' %>">
                                        <div>
                                            <label for="mensagens-campo-9-<%= m.id %>">Data</label>
                                            <input id="mensagens-campo-9-<%= m.id %>" type="date" name="data" value="<%= m.tipo === 'unica' ? m.enviar_em.slice(0, 10) : '' %>" <%= m.tipo === 'unica' ? 'required' : '' %>>
                                        </div>
                                    </div>
                                    <div class="campo-dia-semana form-row" style="<%= m.tipo === 'semanal' ? '' : 'display:none' %>">
                                        <div>
                                            <label for="mensagens-campo-10-<%= m.id %>">Dia da semana</label>
                                            <select id="mensagens-campo-10-<%= m.id %>" name="diaSemana">
                                                <% NOMES_DIA_SEMANA.forEach((nomeDia, i) => { %>
                                                    <option value="<%= i %>" <%= m.dia_semana === i ? 'selected' : '' %>><%= nomeDia.charAt(0).toUpperCase() + nomeDia.slice(1) %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div>
                                            <span class="field-label">Horário</span>
                                            <% const horaAtual = m.tipo === 'semanal' ? m.hora : m.enviar_em.slice(11, 16); %>
                                            <div class="time-select">
                                                <select aria-label="Hora do envio" name="horaH">
                                                    <% for (let h = 0; h < 24; h++) { %>
                                                        <% const hh = String(h).padStart(2, '0'); %>
                                                        <option value="<%= hh %>" <%= horaAtual.slice(0, 2) === hh ? 'selected' : '' %>><%= hh %></option>
                                                    <% } %>
                                                </select>
                                                <span>:</span>
                                                <select aria-label="Minutos do envio" name="horaM">
                                                    <% ['00','15','30','45'].forEach(mm => { %>
                                                        <option value="<%= mm %>" <%= horaAtual.slice(3, 5) === mm ? 'selected' : '' %>><%= mm %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <input type="submit" value="Salvar alterações">
                                    <button type="button" class="secondary edit-toggle" data-target="editar-<%= m.id %>">Cancelar</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
</section>

<script>
    (function () {
        function configurarToggleTipo(form) {
            var campoData = form.querySelector('.campo-data');
            var campoDiaSemana = form.querySelector('.campo-dia-semana');
            var inputData = campoData.querySelector('input[name="data"]');

            form.querySelectorAll('input[name="tipo"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    var semanal = form.querySelector('input[name="tipo"]:checked').value === 'semanal';
                    campoDiaSemana.style.display = semanal ? '' : 'none';
                    campoData.style.display = semanal ? 'none' : '';
                    inputData.required = !semanal;
                });
            });
        }

        document.querySelectorAll('.form-mensagem').forEach(configurarToggleTipo);

        document.querySelectorAll('.edit-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var row = document.getElementById(btn.dataset.target);
                row.style.display = row.style.display === 'none' ? '' : 'none';
            });
        });
    })();
</script>
