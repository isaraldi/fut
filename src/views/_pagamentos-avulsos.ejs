<div class="card">
    <% if (!enquete) { %>
        <p class="empty">Nenhuma enquete registrada ainda. Mande <code>!enquete</code> no grupo do WhatsApp.</p>
    <% } else if (jogadores.length === 0) { %>
        <p class="empty">Nenhuma avulsa confirmada neste jogo.</p>
    <% } else { %>
        <p class="hint">Jogadoras isentas não têm cobrança neste jogo e não geram entrada no caixa.</p>
        <table>
            <thead>
                <tr><th>Nome</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                <% jogadores.forEach(j => { %>
                    <tr>
                        <td><%= j.nome %></td>
                        <td>
                            <span class="badge <%= j.isento || j.pago ? 'pago' : 'pendente' %>">
                                <%= j.isento ? 'Isenta · sem cobrança' : j.pago ? 'Pago' : 'Pendente' %>
                            </span>
                        </td>
                        <td>
                            <div class="avulsas-acoes">
                            <% if (!j.isento) { %>
                            <form method="post" action="/pagamentos/avulsos/<%= j.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="enqueteId" value="<%= enquete.id %>">
                                <button class="secondary btn-icon-label" type="submit">
                                    <% if (j.pago) { %>
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                        Marcar pendente
                                    <% } else { %>
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        Marcar pago
                                    <% } %>
                                </button>
                            </form>
                            <% } %>
                            <% if (!j.pago) { %>
                            <form method="post" action="/pagamentos/avulsos/<%= j.id %>/isencao">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="enqueteId" value="<%= enquete.id %>">
                                <input type="hidden" name="isento" value="<%= j.isento ? '0' : '1' %>">
                                <button class="secondary" type="submit"><%= j.isento ? 'Voltar a cobrar' : 'Isentar neste jogo' %></button>
                            </form>
                            <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>

<style>
    .avulsas-acoes { display: flex; align-items: center; gap: 8px; }
    .avulsas-acoes form { margin: 0; }
    .avulsas-acoes button { white-space: nowrap; }
</style>
