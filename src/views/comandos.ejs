<div class="page-header">
    <div>
        <h1>Comandos</h1>
    </div>
</div>

<nav class="jogo-abas comandos-abas" aria-label="Seções de comandos">
    <a href="/comandos" <%- aba === 'comandos' ? 'aria-current="page"' : '' %>>Comandos</a>
    <a href="/comandos?aba=permissoes" <%- aba === 'permissoes' ? 'aria-current="page"' : '' %>>Permissões</a>
    <a href="/comandos?aba=grupos" <%- aba === 'grupos' ? 'aria-current="page"' : '' %>>Grupos da IA</a>
</nav>

<% if (aba === 'comandos') { %>
<div class="card">
    <h1>Comandos disponíveis</h1>
    <p class="hint">Envie os comandos no grupo ou no privado do bot, conforme a tabela. Só jogadoras autorizadas na aba Permissões podem usá-los.</p>
    <table>
        <thead>
            <tr><th>Comando</th><th>Onde funciona</th><th>O que faz</th></tr>
        </thead>
        <tbody>
            <% comandos.forEach(c => { %>
                <tr>
                    <td><code><%= c.comando %></code></td>
                    <td><%= c.onde %></td>
                    <td><%= c.descricao %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<div class="card">
    <h1>Tokens disponíveis</h1>
    <p class="hint">Cada campo é substituído apenas no modelo indicado em “Onde usar”.</p>
    <table>
        <thead>
            <tr><th>Token</th><th>Onde usar</th><th>O que vira</th></tr>
        </thead>
        <tbody>
            <% tokens.forEach(t => { %>
                <tr>
                    <td><code><%= t.token %></code></td>
                    <td><%= t.onde %></td>
                    <td><%= t.descricao %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<div class="card">
    <h1>Formatação de mensagem</h1>
    <p class="hint">Digite os símbolos no texto para formatar mensagens no WhatsApp.</p>
    <table>
        <thead>
            <tr><th>Pra fazer isso</th><th>Digite assim</th></tr>
        </thead>
        <tbody>
            <tr><td><strong>negrito</strong></td><td><code>*negrito*</code></td></tr>
            <tr><td><em>itálico</em></td><td><code>_itálico_</code></td></tr>
            <tr><td><del>riscado</del></td><td><code>~riscado~</code></td></tr>
            <tr><td><code>monoespaçado</code></td><td><code>```monoespaçado```</code></td></tr>
            <tr><td>Lista</td><td><code>- item</code> (um por linha)</td></tr>
        </tbody>
    </table>
</div>

<% } else if (aba === 'permissoes') { %>
<div class="card">
    <h1>Quem pode usar comandos</h1>
    <p class="hint">Autorize quem pode usar os comandos do bot. É preciso ter cadastro no elenco. Ninguém é autorizado por padrão; libere ao menos seu próprio cadastro.</p>
    <% if (jogadores.length === 0) { %>
        <p class="empty">Nenhuma jogadora cadastrada ainda.</p>
    <% } else { %>
        <table>
            <thead>
                <tr><th>Nome</th><th>Telefone</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                <% jogadores.forEach(j => { %>
                    <tr>
                        <td><%= j.nome %></td>
                        <td><%= j.telefone || '—' %></td>
                        <td>
                            <span class="badge <%= j.pode_comandar ? 'pago' : 'pendente' %>">
                                <%= j.pode_comandar ? 'Liberado' : 'Bloqueado' %>
                            </span>
                        </td>
                        <td>
                            <form method="post" action="/comandos/<%= j.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button class="secondary btn-icon-label" type="submit">
                                    <% if (j.pode_comandar) { %>
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
                                        Bloquear
                                    <% } else { %>
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
                                        Liberar
                                    <% } %>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>
<% } else { %>
<div class="card">
    <h1>Onde a IA pode receber pedidos</h1>
    <p class="hint">Libere um ou mais grupos para conversar com o bot por IA. É preciso mencionar o bot usando a menção do WhatsApp e estar autorizado na aba Permissões.</p>
    <p class="hint">Todos os grupos usam os dados do mesmo futebol. Enquetes e envios automáticos continuam indo para o grupo definido em <a href="/enquete/config">Enquete e envio automático</a>.</p>
    <% if (!gruposIa.ativa) { %>
        <p class="hint">A IA para mensagens está desativada. As permissões abaixo serão usadas quando ela for ativada.</p>
    <% } %>
    <% if (gruposIa.modo === 'invalida') { %>
        <p class="erro" role="alert">A configuração salva está inválida e nenhum grupo está liberado. Confira os grupos abaixo e salve novamente.</p>
    <% } %>
    <% if (erro) { %><p class="erro" role="alert"><%= erro %></p><% } %>
    <form method="post" action="/comandos/grupos-ia">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="switch-row">
            <input type="radio" id="ia-grupos-padrao" name="modo" value="padrao" <%= gruposIa.modo === 'padrao' ? 'checked' : '' %>>
            <label for="ia-grupos-padrao">Seguir o grupo da enquete</label>
        </div>
        <div class="switch-row">
            <input type="radio" id="ia-grupos-selecionados" name="modo" value="selecionados" <%= gruposIa.modo !== 'padrao' ? 'checked' : '' %>>
            <label for="ia-grupos-selecionados">Usar os grupos selecionados abaixo</label>
        </div>
        <p class="hint">Para liberar vários grupos, escolha a segunda opção e marque todos os desejados. Sem nenhum marcado nessa opção, a IA atende somente no privado.</p>
        <% if (gruposIa.grupos.length === 0) { %>
            <p class="empty">Nenhum grupo disponível. Os grupos aparecem quando o bot conecta e sincroniza os grupos do WhatsApp.</p>
        <% } else { %>
            <p class="hint">Os indicadores mostram as permissões salvas. Clique em Salvar grupos da IA para aplicar as alterações.</p>
            <ul class="ia-grupos-lista">
                <% gruposIa.grupos.forEach((g, indice) => { %>
                    <li class="switch-row">
                        <input type="checkbox" id="ia-grupo-<%= indice %>" name="grupos" value="<%= g.whatsapp_id %>" <%= g.permitido ? 'checked' : '' %>>
                        <label for="ia-grupo-<%= indice %>"><%= g.nome %></label>
                        <span class="badge <%= g.permitido ? 'pago' : 'pendente' %>"><%= g.permitido ? 'Liberado' : 'Bloqueado' %></span>
                    </li>
                <% }) %>
            </ul>
        <% } %>
        <input type="submit" value="Salvar grupos da IA">
    </form>
</div>
<% } %>
