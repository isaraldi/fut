<div class="page-header">
    <div>
        <h1>Jogadores</h1>
        <p><%= jogadores.length %> cadastrado<%= jogadores.length === 1 ? '' : 's' %></p>
    </div>
</div>

<div class="card">
    <h1>Adicionar jogador</h1>
    <form method="post" action="/elenco">
        <div class="form-row">
            <div>
                <label>Nome</label>
                <input type="text" name="nome" required>
            </div>
            <div>
                <label>Telefone (opcional)</label>
                <input type="text" name="telefone">
            </div>
        </div>
        <div class="form-row">
            <div>
                <label>Nível (1-5)</label>
                <input type="number" name="nivel" min="1" max="5" value="3">
            </div>
            <div>
                <label>Papel</label>
                <select name="papel">
                    <option value="mensalista">Mensalista</option>
                    <option value="avulso" selected>Avulso</option>
                </select>
            </div>
        </div>
        <input type="submit" value="Adicionar">
    </form>
</div>

<div class="card">
    <h1>Lista de jogadores</h1>
    <% if (jogadores.length === 0) { %>
        <p class="empty">Ninguém cadastrado ainda — vote em uma enquete no WhatsApp ou adicione manualmente acima.</p>
    <% } else { %>
        <table>
            <thead>
                <tr><th>Nome</th><th>Telefone</th><th>Nível</th><th>Papel</th><th></th></tr>
            </thead>
            <tbody>
                <% jogadores.forEach(j => { %>
                    <tr>
                        <td><input type="text" name="nome" form="edit-<%= j.id %>" value="<%= j.nome %>" required></td>
                        <td><input type="text" name="telefone" form="edit-<%= j.id %>" value="<%= j.telefone || '' %>"></td>
                        <td><input type="number" name="nivel" form="edit-<%= j.id %>" min="1" max="5" value="<%= j.nivel %>"></td>
                        <td>
                            <select name="papel" form="edit-<%= j.id %>">
                                <option value="mensalista" <%= j.papel === 'mensalista' ? 'selected' : '' %>>Mensalista</option>
                                <option value="avulso" <%= j.papel === 'avulso' ? 'selected' : '' %>>Avulso</option>
                            </select>
                        </td>
                        <td style="white-space:nowrap">
                            <form id="edit-<%= j.id %>" method="post" action="/elenco/<%= j.id %>" style="display:inline">
                                <button type="submit">Salvar</button>
                            </form>
                            <a href="/elenco/<%= j.id %>/historico" class="secondary" style="display:inline-block;padding:8px 10px;border:1px solid var(--border);border-radius:6px;text-decoration:none;color:var(--text)">Histórico</a>
                            <form method="post" action="/elenco/<%= j.id %>/excluir" style="display:inline" onsubmit="return confirm('Remover <%= j.nome %>?')">
                                <button class="danger" type="submit">Excluir</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>
