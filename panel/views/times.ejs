<div class="page-header">
    <div>
        <h1>Times</h1>
        <p>Sorteio inteligente balanceado por nível</p>
    </div>
</div>

<% if (!enquete) { %>
    <div class="card">
        <p class="empty">Nenhuma enquete registrada ainda. Mande <code>!enquete</code> no grupo do WhatsApp.</p>
    </div>
<% } else if (confirmados.length < 2) { %>
    <div class="card">
        <h1><%= enquete.titulo %></h1>
        <p class="empty">Ainda não há confirmados suficientes pra sortear os times (mínimo 2).</p>
    </div>
<% } else { %>
    <div class="card">
        <h1><%= enquete.titulo %></h1>
        <h2><%= confirmados.length %> confirmado<%= confirmados.length === 1 ? '' : 's' %></h2>
        <form method="get" action="/times">
            <button type="submit" class="btn-icon-label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
                Sortear de novo
            </button>
        </form>
    </div>

    <div class="card">
        <div class="team-cols">
            <div class="team-col">
                <h2><span class="team-dot" style="background:var(--accent-blue)"></span> Time A <span class="team-sum">(soma de nível: <%= times.somaA %>)</span></h2>
                <table>
                    <tbody>
                        <% times.timeA.forEach(j => { %>
                            <tr><td><%= j.nome %></td><td><span class="badge <%= j.posicao %>"><%= j.posicao %></span></td><td><span class="badge <%= j.papel %>"><%= j.nivel %></span></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="team-col">
                <h2><span class="team-dot" style="background:var(--critical)"></span> Time B <span class="team-sum">(soma de nível: <%= times.somaB %>)</span></h2>
                <table>
                    <tbody>
                        <% times.timeB.forEach(j => { %>
                            <tr><td><%= j.nome %></td><td><span class="badge <%= j.posicao %>"><%= j.posicao %></span></td><td><span class="badge <%= j.papel %>"><%= j.nivel %></span></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<% } %>
