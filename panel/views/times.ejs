<div class="page-header">
    <div>
        <h1>Times</h1>
        <p>Times balanceados por nível. Ajuste as jogadoras antes de enviar; quem estiver como “Faltou” não participa do sorteio.</p>
    </div>
</div>


<% if (!enquete) { %>
    <div class="card">
        <p class="empty">Nenhuma enquete registrada ainda. Mande <code>!enquete</code> no grupo do WhatsApp.</p>
    </div>
<% } else if (!plano) { %>
    <div class="card">
        <h1><%= enquete.titulo %></h1>
        <p class="empty">Ainda não há confirmadas suficientes pra sortear os times (mínimo 2, sem contar quem faltou).</p>
    </div>
<% } else { %>
    <% const nomesDestino = { A: 'Time A', B: 'Time B', C: 'Time C', reserva: 'Reserva', ausente: 'Faltou' }; %>
    <div class="card">
        <h1><%= enquete.titulo %></h1>
        <h2><%= confirmados.length %> confirmada<%= confirmados.length === 1 ? '' : 's' %>, <%= plano.times.length %> times<%= plano.reservas.length ? ' + ' + plano.reservas.length + ' reserva(s)' : '' %></h2>
        <% if (modoManual) { %><p class="hint">Modo manual: monte e envie por esta página. O comando <code>!times</code> fica desativado.</p><% } %>
        <a href="/times" class="btn-icon-label">Sortear de novo</a>
    </div>

    <form method="post" action="/times/enviar"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card">
            <table>
                <thead><tr><th>Nome</th><th>Posição</th><th>Nível</th><th>Destino</th></tr></thead>
                <tbody>
                    <% confirmados.forEach(j => { %>
                        <tr>
                            <td><%= j.nome %></td>
                            <td><span class="badge <%= j.posicao %>"><%= j.posicao %></span></td>
                            <td><span class="badge <%= j.papel %>"><%= j.nivel %></span></td>
                            <td>
                                <select aria-label="Time de <%= j.nome %>" name="dest_<%= j.id %>">
                                    <% Object.keys(nomesDestino).filter(d => d !== 'C' || plano.times.length === 3).forEach(d => { %>
                                        <option value="<%= d %>" <%= destinos[j.id] === d ? 'selected' : '' %>><%= nomesDestino[d] %></option>
                                    <% }) %>
                                </select>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            <p class="hint">
                Soma de nível:
                <% plano.somas.forEach((soma, t) => { %>Time <%= 'ABC'[t] %>: <%= soma %><%= t < plano.somas.length - 1 ? ' · ' : '' %><% }) %>
                (a ordem de rodízio é sorteada na hora de enviar)
            </p>
            <button type="submit" formaction="/times/ausentes" class="btn-icon-label secondary">Salvar faltas e sortear de novo</button>
            <button type="submit" class="btn-icon-label">Enviar times ao grupo</button>
        </div>
    </form>
<% } %>
