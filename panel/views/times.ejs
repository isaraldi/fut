<div class="page-header">
    <div>
        <h1>Times</h1>
        <p>Sorteio inteligente balanceado por nível</p>
    </div>
</div>

<% if (!enquete) { %>
    <div class="card">
        <p class="empty">Nenhuma enquete registrada ainda. Mande <code>!enquete</code> no grupo do WhatsApp.</p>
    </div>
<% } else if (confirmados.length < 2) { %>
    <div class="card">
        <h1><%= enquete.titulo %></h1>
        <p class="empty">Ainda não há confirmados suficientes pra sortear os times (mínimo 2).</p>
    </div>
<% } else { %>
    <div class="card">
        <h1><%= enquete.titulo %></h1>
        <h2><%= confirmados.length %> confirmado<%= confirmados.length === 1 ? '' : 's' %></h2>
        <form method="get" action="/times">
            <button type="submit">🔀 Sortear de novo</button>
        </form>
    </div>

    <div class="card">
        <div class="team-cols">
            <div class="team-col">
                <h2>🔵 Time A <span class="team-sum">(soma de nível: <%= times.somaA %>)</span></h2>
                <table>
                    <tbody>
                        <% times.timeA.forEach(j => { %>
                            <tr><td><%= j.nome %></td><td><span class="badge <%= j.posicao %>"><%= j.posicao %></span></td><td><span class="badge <%= j.papel %>"><%= j.nivel %></span></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="team-col">
                <h2>🔴 Time B <span class="team-sum">(soma de nível: <%= times.somaB %>)</span></h2>
                <table>
                    <tbody>
                        <% times.timeB.forEach(j => { %>
                            <tr><td><%= j.nome %></td><td><span class="badge <%= j.posicao %>"><%= j.posicao %></span></td><td><span class="badge <%= j.papel %>"><%= j.nivel %></span></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<% } %>
