<div class="page-header">
    <div>
        <h1>Configurações da enquete</h1>
    </div>
</div>

<section class="section">
    <div class="card">
        <h1>Enviar agora</h1>
        <p class="hint">
            Abre a enquete no grupo configurado abaixo na hora, sem precisar mandar
            <code>!enquete</code> pelo WhatsApp.
        </p>
        <form method="post" action="/enquete/config/enviar-agora" data-confirm="Enviar a enquete agora pro grupo?"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="submit" value="🗳️ Enviar enquete agora" <%= grupoSelecionado ? '' : 'disabled' %>>
        </form>
        <% if (!grupoSelecionado) { %>
            <p class="hint">Selecione o grupo de destino abaixo antes de enviar.</p>
        <% } %>
    </div>

    <div class="card">
        <h1>Envio automático</h1>
        <p class="hint">
            Dia e horário em que a <strong>enquete é disparada</strong> — diferente do dia/horário
            do jogo (configurado em <a href="/jogo/config">Configurações → Jogo</a>, que só define a
            data que aparece no texto da enquete). Ex: jogo quarta-feira às 20h, mas a enquete pode
            ser mandada segunda-feira de manhã.
        </p>
        <% if (grupos.length === 0) { %>
            <p class="hint">
                ⚠️ Ainda não conheço nenhum grupo. A lista é sincronizada automaticamente quando o
                bot conecta no WhatsApp — espere o bot ficar online e recarregue esta página.
            </p>
        <% } %>
        <form method="post" action="/enquete/config/auto"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-row">
                <div>
                    <label>Grupo de destino</label>
                    <select name="grupoId" <%= grupos.length === 0 ? 'disabled' : '' %>>
                        <% if (!grupoSelecionado) { %>
                            <option value="" selected disabled>Selecione um grupo</option>
                        <% } %>
                        <% grupos.forEach(g => { %>
                            <option value="<%= g.whatsapp_id %>" <%= grupoSelecionado === g.whatsapp_id ? 'selected' : '' %>><%= g.nome %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div>
                    <label>Dia da semana do envio</label>
                    <select name="envioDiaSemana">
                        <option value="0" <%= envioDiaSemana === 0 ? 'selected' : '' %>>Domingo</option>
                        <option value="1" <%= envioDiaSemana === 1 ? 'selected' : '' %>>Segunda-feira</option>
                        <option value="2" <%= envioDiaSemana === 2 ? 'selected' : '' %>>Terça-feira</option>
                        <option value="3" <%= envioDiaSemana === 3 ? 'selected' : '' %>>Quarta-feira</option>
                        <option value="4" <%= envioDiaSemana === 4 ? 'selected' : '' %>>Quinta-feira</option>
                        <option value="5" <%= envioDiaSemana === 5 ? 'selected' : '' %>>Sexta-feira</option>
                        <option value="6" <%= envioDiaSemana === 6 ? 'selected' : '' %>>Sábado</option>
                    </select>
                </div>
                <div>
                    <label>Horário do envio</label>
                    <div class="time-select">
                        <select name="envioHoraH">
                            <% for (let h = 0; h < 24; h++) { %>
                                <% const hh = String(h).padStart(2, '0'); %>
                                <option value="<%= hh %>" <%= envioHora.split(':')[0] === hh ? 'selected' : '' %>><%= hh %></option>
                            <% } %>
                        </select>
                        <span>:</span>
                        <select name="envioHoraM">
                            <% ['00','15','30','45'].forEach(mm => { %>
                                <option value="<%= mm %>" <%= envioHora.split(':')[1] === mm ? 'selected' : '' %>><%= mm %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
            </div>
            <div class="switch-row">
                <input type="checkbox" id="autoEnviar" name="autoEnviar" <%= autoEnviar ? 'checked' : '' %>>
                <label for="autoEnviar">Enviar enquete automaticamente no dia/horário acima</label>
            </div>
            <input type="submit" value="Salvar">
        </form>
    </div>
</section>

<section class="section">
    <h1 class="section-title">Configuração da enquete</h1>

    <div class="card">
        <h1>Título da enquete</h1>
        <p class="hint">
            Tokens disponíveis: <code>{data}</code> (ex: 05/08), <code>{dia}</code> (ex: quarta-feira)
            e <code>{hora}</code> (ex: 20:00) — vêm da <a href="/jogo/config">configuração do jogo</a>.
        </p>
        <form method="post" action="/enquete/config/titulo"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="titulo" value="<%= titulo %>" required>
            <input type="submit" value="Salvar título">
        </form>
    </div>

    <div class="card">
        <h1>Adicionar opção</h1>
        <form method="post" action="/enquete/config/opcoes"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-row">
                <div>
                    <label>Texto da opção</label>
                    <input type="text" name="texto" required>
                </div>
                <div>
                    <label>Conta como confirmada?</label>
                    <select name="conta">
                        <option value="1">Sim (ex: "eu vou")</option>
                        <option value="0">Não (ex: "não vou")</option>
                    </select>
                </div>
            </div>
            <p class="hint">
                O papel da confirmação (mensalista/avulsa) segue sempre o cadastro da jogadora em
                <a href="/elenco">Jogadores</a> — não depende mais de qual opção ela escolhe aqui.
            </p>
            <input type="submit" value="Adicionar opção">
        </form>
    </div>

    <div class="card">
        <h1>Opções atuais (<%= opcoes.length %>)</h1>
        <p class="hint">Valem pra próxima enquete que você abrir com <code>!enquete</code>. Enquetes já enviadas não mudam.</p>
        <% if (opcoes.length === 0) { %>
            <p class="empty">Nenhuma opção configurada — adicione pelo menos 2 acima.</p>
        <% } else { %>
            <table>
                <thead>
                    <tr><th>Texto</th><th>Conta como confirmada?</th><th></th></tr>
                </thead>
                <tbody>
                    <% opcoes.forEach(o => { %>
                        <tr>
                            <td><input type="text" name="texto" form="opcao-<%= o.id %>" value="<%= o.texto %>" required></td>
                            <td>
                                <select name="conta" form="opcao-<%= o.id %>">
                                    <option value="1" <%= o.conta === 1 ? 'selected' : '' %>>Sim</option>
                                    <option value="0" <%= o.conta === 0 ? 'selected' : '' %>>Não</option>
                                </select>
                            </td>
                            <td style="white-space:nowrap">
                                <form id="opcao-<%= o.id %>" method="post" action="/enquete/config/opcoes/<%= o.id %>" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="icon-btn secondary" type="submit" title="Salvar" aria-label="Salvar opção">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    </button>
                                </form>
                                <form method="post" action="/enquete/config/opcoes/<%= o.id %>/excluir" style="display:inline" data-confirm="Remover essa opção?"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="icon-btn danger" type="submit" title="Excluir" aria-label="Excluir opção">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
</section>
