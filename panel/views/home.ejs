<div class="page-header">
    <div>
        <h1>Início</h1>
        <p>O jogo em acompanhamento e o que precisa da sua atenção.</p>
    </div>
</div>

<div class="card inicio-jogo">
    <div>
        <p class="section-eyebrow">Jogo atual</p>
        <% if (jogoAtual) { %>
            <h2><%= jogoAtual.titulo %></h2>
            <p class="hint">Última enquete enviada em <%= formatarDataHora(jogoAtual.criada_em) %>.</p>
            <div class="inicio-jogo-status">
                <span class="badge <%= jogoAtual.fechada_em ? 'pendente' : 'pago' %>"><%= jogoAtual.fechada_em ? 'Lista fechada' : 'Recebendo respostas' %></span>
                <span><strong><%= confirmados %><%= jogoAtual.vagas_maximo ? '/' + jogoAtual.vagas_maximo : '' %></strong> com vaga · <strong><%= espera %></strong> na espera</span>
            </div>
        <% } else { %>
            <h2>Nenhuma enquete enviada</h2>
            <p class="hint">Prepare a enquete para começar a organizar o jogo.</p>
        <% } %>
    </div>
    <div class="inicio-jogo-acoes">
        <% if (jogoAtual) { %>
            <a class="button-link" href="/jogo/atual">Acompanhar jogo</a>
            <a class="button-link secondary" href="/jogo/atual?aba=times">Montar times</a>
        <% } else { %>
            <a class="button-link" href="/enquete/config">Preparar enquete</a>
        <% } %>
    </div>
</div>

<section aria-labelledby="inicio-pendencias">
    <div class="page-header"><div><h2 id="inicio-pendencias">Precisa de atenção</h2><p>Pagamentos do ciclo <%= mes %> e andamento do mensal.</p></div></div>
    <div class="inicio-pendencias">
        <% [
            [pendentes, 'Mensalidades pendentes', pagamentosMes.pagos + ' de ' + pagamentosMes.devem + ' mensalistas com pagamento registrado.', '/pagamentos/mensalistas?mes=' + mes],
            [avulsasPendentes, 'Avulsas com pagamento pendente', 'Jogadoras com vaga na última enquete.', '/pagamentos/avulsos'],
            [renovacoesPendentes, 'Renovações sem resposta', 'Acompanhe o prazo de prioridade do mensal.', '/mensal?aba=renovacao'],
            [filaMensal, 'Interessadas na fila do mensal', renovacoesPendentes ? 'Resolva as renovações antes de aprovar entradas.' : 'Confira as vagas antes de aprovar entradas.', '/mensal?aba=renovacao']
        ].forEach(([quantidade, titulo, descricao, destino]) => { %>
            <a class="card inicio-pendencia" href="<%= destino %>">
                <span class="inicio-pendencia-numero <%= quantidade ? 'com-pendencia' : '' %>"><%= quantidade %></span>
                <div><h3><%= titulo %></h3><p class="hint"><%= descricao %></p></div>
                <span aria-hidden="true">→</span>
            </a>
        <% }) %>
    </div>
</section>

<div class="inicio-secundario">
    <section class="card">
        <div class="page-header"><h2>Jogos recentes</h2><a href="/jogos">Ver histórico</a></div>
        <% if (!ultimosJogos.length) { %>
            <p class="empty">Os jogos aparecerão aqui após o envio da primeira enquete.</p>
        <% } else { %>
            <ul class="inicio-jogos">
                <% ultimosJogos.forEach(j => { %>
                    <li><a href="/jogos/<%= j.id %>"><strong><%= j.titulo %></strong><span><%= j.confirmados %> com vaga · <%= formatarDataHora(j.criada_em) %></span></a></li>
                <% }) %>
            </ul>
        <% } %>
    </section>
    <section class="card">
        <h2>Jogadoras</h2>
        <p class="inicio-total"><%= jogadoras.total %> <span>ativas</span></p>
        <p class="hint"><%= jogadoras.mensalistas %> mensalistas · <%= jogadoras.total - jogadoras.mensalistas %> avulsas</p>
        <a class="button-link secondary" href="/elenco">Gerenciar jogadoras</a>
        <p class="hint inicio-link-comunicacao"><a href="/mensagens">Envios e agendamentos →</a></p>
    </section>
</div>
