<% const podeRemover = typeof enqueteId !== 'undefined' && enqueteId; %>
<% Object.entries(grupos).forEach(([opcao, votos]) => { %>
    <div class="card">
        <h2><%= opcao %> (<%= votos.length %>)</h2>
        <% if (votos.length === 0) { %>
            <p class="empty">Ninguém ainda.</p>
        <% } else { %>
            <table>
                <thead>
                    <tr><th>Nome</th><th>Papel</th><th>Nível</th><% if (podeRemover) { %><th></th><% } %></tr>
                </thead>
                <tbody>
                    <% votos.forEach(v => { %>
                        <tr>
                            <td><%= v.nome %></td>
                            <td><span class="badge <%= v.papel %>"><%= v.papel %></span></td>
                            <td><%= v.nivel %></td>
                            <% if (podeRemover) { %>
                                <td style="white-space:nowrap">
                                    <form method="post" action="/jogos/<%= enqueteId %>/confirmar/<%= v.jogador_id %>/remover" style="display:inline" data-confirm="Remover confirmação de {nome}?" data-confirm-nome="<%= v.nome %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button class="icon-btn danger" type="submit" title="Remover" aria-label="Remover confirmação de <%= v.nome %>">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                        </button>
                                    </form>
                                </td>
                            <% } %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
<% }) %>
