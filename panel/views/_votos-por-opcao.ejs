<% const podeRemover = typeof enqueteId !== 'undefined' && enqueteId; %>
<% Object.entries(grupos).forEach(([opcao, votos]) => { %>
    <div class="card">
        <h2><%= opcao %> (<%= votos.length %>)</h2>
        <% if (votos.length === 0) { %>
            <p class="empty">Ninguém ainda.</p>
        <% } else { %>
            <table>
                <thead>
                    <tr><th>Nome</th><th>Papel</th><th>Nível</th><% if (podeRemover) { %><th></th><% } %></tr>
                </thead>
                <tbody>
                    <% votos.forEach(v => { %>
                        <tr>
                            <td><%= v.nome %></td>
                            <td><span class="badge <%= v.papel %>"><%= v.papel %></span></td>
                            <td><%= v.nivel %></td>
                            <% if (podeRemover) { %>
                                <td style="white-space:nowrap">
                                    <form method="post" action="/jogos/<%= enqueteId %>/confirmar/<%= v.jogador_id %>/remover" style="display:inline" data-confirm="Remover confirmação de {nome}?" data-confirm-nome="<%= v.nome %>">
                                        <button class="danger" type="submit">Remover</button>
                                    </form>
                                </td>
                            <% } %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
<% }) %>
