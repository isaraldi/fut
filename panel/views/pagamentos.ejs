<div class="page-header">
    <div>
        <h1>Pagamentos</h1>
        <p><%= mes %></p>
    </div>
</div>

<div class="card">
    <% if (jogadores.length === 0) { %>
        <p class="empty">Nenhum jogador cadastrado ainda. Cadastre em <a href="/elenco">Jogadores</a>.</p>
    <% } else { %>
        <table>
            <thead>
                <tr><th>Nome</th><th>Papel</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                <% jogadores.forEach(j => { %>
                    <tr>
                        <td><%= j.nome %></td>
                        <td><span class="badge <%= j.papel %>"><%= j.papel %></span></td>
                        <td>
                            <span class="badge <%= j.pago ? 'pago' : 'pendente' %>">
                                <%= j.pago ? 'Pago' : 'Pendente' %>
                            </span>
                        </td>
                        <td>
                            <form method="post" action="/pagamentos/<%= j.id %>/toggle">
                                <input type="hidden" name="mes" value="<%= mes %>">
                                <button class="secondary" type="submit">
                                    Marcar <%= j.pago ? 'pendente' : 'pago' %>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>
