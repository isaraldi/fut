<div class="page-header">
    <div>
        <h1>Histórico de jogos</h1>
        <p><%= jogos.length %> jogo<%= jogos.length === 1 ? '' : 's' %> registrado<%= jogos.length === 1 ? '' : 's' %></p>
    </div>
</div>

<div class="card">
    <% if (jogos.length === 0) { %>
        <p class="empty">Nenhuma enquete registrada ainda. Mande <code>!enquete</code> no grupo do WhatsApp.</p>
    <% } else { %>
        <table>
            <thead>
                <tr><th>Jogo</th><th>Criada em</th><th>Confirmados</th><th>Respostas</th><th></th><th></th></tr>
            </thead>
            <tbody>
                <% jogos.forEach(j => { %>
                    <tr>
                        <td><%= j.titulo %></td>
                        <td><%= j.criada_em %></td>
                        <td><%= j.confirmados %></td>
                        <td><%= j.total_respostas %></td>
                        <td><a href="/jogos/<%= j.id %>">Ver detalhe →</a></td>
                        <td>
                            <form method="post" action="/jogos/<%= j.id %>/excluir" data-confirm="Excluir {nome}? Isso apaga as confirmações e avaliações desse jogo." data-confirm-nome="<%= j.titulo %>">
                                <button class="danger" type="submit">Excluir</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>
