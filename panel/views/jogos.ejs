<div class="page-header">
    <div><h1>Histórico de jogos</h1><p><%= jogos.length %> jogo<%= jogos.length === 1 ? '' : 's' %> registrado<%= jogos.length === 1 ? '' : 's' %>, do mais recente ao mais antigo.</p></div>
    <a class="button-link secondary" href="/jogo/atual">Jogo atual</a>
</div>
<div class="card">
    <% if (!jogos.length) { %>
        <p class="empty">Nenhum jogo registrado. Envie uma enquete para começar.</p>
        <a class="button-link" href="/enquete/config">Preparar enquete</a>
    <% } else { %>
        <div class="form-row">
            <div><label for="historico-busca">Buscar jogo</label><input type="text" id="historico-busca" placeholder="Título ou data da enquete" autocomplete="off"></div>
            <div><label for="historico-status">Situação da enquete</label><select id="historico-status"><option value="todas">Todas</option><option value="aberta">Enquete aberta</option><option value="fechada">Lista fechada</option></select></div>
        </div>
        <p class="hint" role="status" data-historico-resultado><%= jogos.length %> jogo<%= jogos.length === 1 ? '' : 's' %></p>
        <ul class="historico-lista">
            <% jogos.forEach(j => { %>
                <li data-historico-jogo data-situacao="<%= j.fechada_em ? 'fechada' : 'aberta' %>">
                    <a class="historico-jogo" href="/jogos/<%= j.id %>">
                        <div><strong><%= j.titulo %></strong><span class="hint">Enquete enviada em <%= formatarDataHora(j.criada_em) %></span></div>
                        <div class="historico-jogo-resumo">
                            <span class="badge <%= j.fechada_em ? 'pendente' : 'pago' %>"><%= j.fechada_em ? 'Lista fechada' : 'Enquete aberta' %></span>
                            <span><%= j.confirmados %> com vaga · <%= j.espera %> na espera · <%= j.total_avaliacoes %> nota<%= j.total_avaliacoes === 1 ? '' : 's' %></span>
                        </div>
                        <span class="historico-ver">Ver jogo →</span>
                    </a>
                </li>
            <% }) %>
        </ul>
        <p class="empty" data-historico-vazio hidden>Nenhum jogo encontrado. Altere a busca ou a situação.</p>
    <% } %>
</div>
<script src="/historico.js" defer></script>
