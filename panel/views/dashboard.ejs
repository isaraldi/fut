<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8">
    <title>Painel do Fut - Confirmados</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('_nav') %>

    <div class="container">
        <% if (!enquete) { %>
            <div class="card">
                <p class="empty">Nenhuma enquete registrada ainda. Mande <code>!enquete</code> no grupo do WhatsApp.</p>
            </div>
        <% } else { %>
            <div class="card">
                <h1><%= enquete.titulo %></h1>
                <h2><%= totalVotos %> resposta<%= totalVotos === 1 ? '' : 's' %></h2>
            </div>

            <%- include('_votos-por-opcao', { grupos }) %>
        <% } %>
    </div>
</body>
</html>
