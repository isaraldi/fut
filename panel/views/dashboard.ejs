<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8">
    <title>Painel do Fut - Confirmados</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="topbar">
        <nav>
            <a href="/">Confirmados</a>
            <a href="/pagamentos">Pagamentos</a>
            <a href="/elenco">Elenco</a>
        </nav>
        <form method="post" action="/logout">
            <span style="margin-right:10px;color:var(--muted)"><%= usuario %></span>
            <button class="secondary" type="submit">Sair</button>
        </form>
    </div>

    <div class="container">
        <% if (!enquete) { %>
            <div class="card">
                <p class="empty">Nenhuma enquete registrada ainda. Mande <code>!enquete</code> no grupo do WhatsApp.</p>
            </div>
        <% } else { %>
            <div class="card">
                <h1><%= enquete.titulo %></h1>
                <h2><%= totalVotos %> resposta<%= totalVotos === 1 ? '' : 's' %></h2>
            </div>

            <% Object.entries(grupos).forEach(([opcao, votos]) => { %>
                <div class="card">
                    <h2><%= opcao %> (<%= votos.length %>)</h2>
                    <% if (votos.length === 0) { %>
                        <p class="empty">Ninguém ainda.</p>
                    <% } else { %>
                        <table>
                            <thead>
                                <tr><th>Nome</th><th>Papel</th><th>Nível</th></tr>
                            </thead>
                            <tbody>
                                <% votos.forEach(v => { %>
                                    <tr>
                                        <td><%= v.nome %></td>
                                        <td><span class="badge <%= v.papel %>"><%= v.papel %></span></td>
                                        <td><%= v.nivel %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            <% }) %>
        <% } %>
    </div>
</body>
</html>
