<div class="card">
    <h1>Confirmar manualmente</h1>
    <p class="hint">Pra quando alguém joga mas não respondeu (ou respondeu errado) a enquete no WhatsApp.</p>
    <form method="post" action="/jogos/<%= enquete.id %>/confirmar"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
            <div>
                <label>Jogadora</label>
                <select name="jogador_id" required>
                    <option value="">Selecione...</option>
                    <% jogadores.forEach(j => { %>
                        <option value="<%= j.id %>"><%= j.nome %> (<%= j.papel === 'mensalista' ? 'Mensalista' : 'Avulsa' %>)</option>
                    <% }) %>
                </select>
            </div>
        </div>
        <p class="hint">O papel (mensalista/avulsa) é o cadastrado em <a href="/elenco">Jogadores</a> — atualize lá se estiver errado.</p>
        <input type="submit" value="Confirmar presença">
    </form>
</div>
