<div class="card">
    <h1>Confirmar manualmente</h1>
    <p class="hint">Adicione quem não respondeu à enquete ou votou na opção errada.</p>
    <form method="post" action="/jogos/<%= enquete.id %>/confirmar"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (typeof voltarAtual !== 'undefined' && voltarAtual) { %><input type="hidden" name="voltarAtual" value="1"><% } %>
        <div class="form-row">
            <div>
                <label for="confirmar-manual-campo-1">Jogadora</label>
                <select id="confirmar-manual-campo-1" name="jogador_id" required>
                    <option value="">Selecione...</option>
                    <% jogadores.forEach(j => { %>
                        <option value="<%= j.id %>"><%= j.nome %> (<%= j.papel === 'mensalista' ? 'Mensalista' : 'Avulsa' %>)</option>
                    <% }) %>
                </select>
            </div>
        </div>
        <p class="hint">A categoria vem do cadastro em <a href="/elenco">Jogadoras</a>. Corrija lá, se necessário.</p>
        <input type="submit" value="Confirmar presença">
    </form>
</div>
