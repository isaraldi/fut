<div class="page-header">
    <div>
        <h1>Confirmados</h1>
        <p>Respostas da última enquete enviada no grupo</p>
    </div>
</div>

<% if (!enquete) { %>
    <div class="card">
        <p class="empty">Nenhuma enquete registrada ainda. Mande <code>!enquete</code> no grupo do WhatsApp.</p>
    </div>
<% } else { %>
    <div class="card">
        <h1><%= enquete.titulo %></h1>
        <h2><%= totalVotos %> resposta<%= totalVotos === 1 ? '' : 's' %></h2>
        <% if (enquete.fechada_em) { %>
            <p class="hint">🔒 Lista fechada em <%= enquete.fechada_em %> — novos votos no WhatsApp não contam mais.</p>
        <% } %>
        <form method="post" action="/confirmados/enviar-lista">
            <button type="submit" class="btn-icon-label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                <%= enquete.fechada_em ? 'Mandar lista de novo' : 'Mandar lista pro grupo' %>
            </button>
        </form>
    </div>

    <%- include('_confirmar-manual', { enquete, jogadores }) %>

    <%- include('_votos-por-opcao', { grupos, enqueteId: enquete.id }) %>
<% } %>
